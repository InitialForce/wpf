<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>AllocParser</AssemblyName>
    <RootNamespace>AllocParser</RootNamespace>
    <!-- Self-contained publish: dotnet publish -c Release -r win-x64 /p:SelfContained=true -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in sync with WPF_NAMESPACE_PATTERNS / WPF_MODULE_NAMES in profile.py -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.2" />
  </ItemGroup>

</Project>
