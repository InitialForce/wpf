<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>wpf-perf-analyze</AssemblyName>
    <RootNamespace>WpfPerfAnalyze</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>
    <Optimize>false</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the test project subfolder from this project's compile glob -->
    <Compile Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- TraceProcessor: Windows ETL file analysis -->
    <PackageReference Include="Microsoft.Windows.EventTracing.Processing.All" Version="1.12.10" />
    <!-- JSON serialization -->
    <!-- System.Text.Json ships in-box with .NET 10, no explicit ref needed -->
  </ItemGroup>

</Project>
