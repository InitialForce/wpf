<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Mirror SC's deployment model: self-contained, win-x64. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <!-- NUnit console runner needs a real entry point. -->
    <StartupObject>InitialForce.WpfSmoke.Program</StartupObject>
    <!-- The WPF Arcade SDK's ClearReferenceCopyLocalPaths target strips NuGet package
         assemblies from output unless this is true (it assumes test projects never
         publish as a standalone exe). Keep it true so the copy-local set is preserved;
         the smoke CI step additionally copies the NUnit assemblies from the package
         cache into the published app directory as a guaranteed backstop. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package under test. Resolved from local feed in CI via -source flag.
         GeneratePathProperty exposes $(PkgInitialForce_WPF), the extracted package
         root, so _AddPatchedWpfCompileReference (PatchedWpfReference.targets) can point the compiler at the patched
         WindowsBase.dll shipped under runtimes/. -->
    <PackageReference Include="InitialForce.WPF" Version="$(InitialForceWpfVersion)"
                      GeneratePathProperty="true" />

    <!-- Test framework. NUnitLite provides the embeddable AutoRun runner the console
         entry point (Program.Main) uses. The smoke harness runs as a self-contained
         published exe rather than under `dotnet test`, so the VSTest adapter and
         Microsoft.NET.Test.Sdk are intentionally absent: Test.Sdk marks the project
         IsTestProject and its targets drop nunitlite.dll from the publish output. -->
    <PackageReference Include="NUnit" Version="4.*" />
    <PackageReference Include="NUnitLite" Version="4.*" />
  </ItemGroup>

  <!-- The benchmark harness lives in its own project (Perf/InitialForce.WpfPerf.csproj)
       with its own BenchmarkDotNet references. Exclude the Perf sources from the smoke
       assembly so it does not reference BenchmarkDotNet: NUnitLite reflects over every
       type at startup, and a type referencing an unresolved BenchmarkDotNet aborts test
       discovery (0 tests) when the smoke exe runs without the benchmark dependency set. -->
  <ItemGroup>
    <Compile Remove="Perf\**\*.cs" />
  </ItemGroup>

  <!-- Golden images ship alongside the project. -->
  <ItemGroup>
    <EmbeddedResource Include="goldens\**\*.png" />
    <EmbeddedResource Include="goldens\**\*.sha256" />
  </ItemGroup>

  <!-- Points the compiler at the patched WPF DLLs; see the comment in the file. -->
  <Import Project="PatchedWpfReference.targets" />

</Project>
