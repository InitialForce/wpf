<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Microbenchmarks: autoresearch BDN harness.

    Lives outside the WPF Arcade SDK orchestration (see Directory.Build.props
    in this dir). Targets the SDK's WindowsDesktop targeting pack at compile
    time, then microbench.py swaps the locally-rebuilt PresentationCore.dll
    into the publish output before each BDN run.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <!-- Benchmark corpora use System.Random for determinism, not security. -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.14.*" />
  </ItemGroup>

  <!--
    Override the runtime-pack WPF assemblies with the locally-built copies
    from the autoresearch fork. UseWPF=true above adds a FrameworkReference
    to Microsoft.WindowsDesktop.App, which propagates two ways into BDN's
    out-of-process inner build (CsProjCoreToolchain regenerates a
    BenchmarkDotNet.Autogenerated.csproj with a ProjectReference back to this
    project): (1) the inner build inherits the framework reference and emits
    "Microsoft.WindowsDesktop.App" into its runtimeconfig.json, so the .NET
    host loads WindowsBase / System.Xaml / PresentationCore from the runtime
    pack at runtime; (2) the inner build's deps.json lists those assemblies
    under the runtimepack target, which the host prefers over the local copy
    in the app dir. Either route silently bypasses any DLL swap microbench.py
    performs in the publish dir.

    Two-part fix:
      1. PrivateAssets="all" on the framework reference (set via Update so it
         survives UseWPF's auto-add). This blocks the framework from
         propagating into BDN's inner build's runtimeconfig — the inner host
         no longer treats Microsoft.WindowsDesktop.App as a needed framework
         at runtime, so it falls through to app-dir probing.
      2. Explicit <Reference HintPath> with Private=true for the three
         locally-buildable assemblies. MSBuild's reference resolution prefers
         explicit references over framework references at compile time, and
         Private=true puts a copy of the local DLL in the inner build's bin
         dir so the host's app-dir probe finds it.

    PresentationFramework is intentionally not overridden — its build cycle
    isn't bypassable with SkipDirectWriteForwarderProjectRef alone, so it
    stays on the runtime pack until that's solved (the only PF-resident
    filter, *WindowLifecycle*, is skip-listed in autoresearch/program.md
    until then). PresentationFramework still resolves via the framework
    fallback because we don't override it; that's an acceptable seam since
    WindowLifecycle is the only PF-touching bench and it uses
    InProcessEmitToolchain anyway (STA-init reasons).
  -->
  <ItemGroup>
    <FrameworkReference Update="Microsoft.WindowsDesktop.App" PrivateAssets="all" />
    <Reference Include="WindowsBase">
      <HintPath>$(MSBuildThisFileDirectory)..\artifacts\bin\WindowsBase\x64\Release\net10.0\WindowsBase.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Xaml">
      <HintPath>$(MSBuildThisFileDirectory)..\artifacts\bin\System.Xaml\x64\Release\net10.0\System.Xaml.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationCore">
      <HintPath>$(MSBuildThisFileDirectory)..\artifacts\bin\PresentationCore\x64\Release\net10.0\PresentationCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
