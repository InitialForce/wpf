<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    InitialForce.WPF.RuntimeOverride.targets
    ==========================================
    Auto-imported (transitively) into every project referencing this package.

    Design: surgical per-assembly replacement controlled by $(IF_OverrideAssemblies).
    Consumers list only the assemblies they need to override; all others are left alone
    and continue to resolve from the installed .NET runtime pack.

    Two targets per listed assembly:
      RemoveRuntimeWpfAsset_<Name>  — strips the named Microsoft DLL from MSBuild copy lists.
      InjectIfWpfAssembly_<Name>    — copies our patched DLL at Build+CopyFilesToOutputDirectory.

    Both targets are conditioned on:
      1. The assembly name appearing in $(IF_OverrideAssemblies), AND
      2. $(RuntimeIdentifier) == 'win-x64' (our runtimes/ only ships win-x64).
         On other RIDs the injection is a no-op and a Warning is emitted.

    Same msquic precedent as InitialForce.WPF (InitialForce.App.csproj in SC master):
      AfterTargets="Build;CopyFilesToOutputDirectory" fires on every F5 inner-loop build.
  -->

  <!-- ── PresentationCore ──────────────────────────────────────────────────────────── -->

  <Target Name="RemoveRuntimeWpfAsset_PresentationCore"
          AfterTargets="ResolveRuntimePackAssets;ResolveLockFileCopyLocalFiles"
          Condition="$(IF_OverrideAssemblies.Contains('PresentationCore'))
                     and '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)"
        Condition="'%(Filename)%(Extension)' == 'PresentationCore.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)%(Extension)' == 'PresentationCore.dll'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)%(Extension)' == 'PresentationCore.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="WarnIfUnsupportedRid_PresentationCore"
          AfterTargets="Build;CopyFilesToOutputDirectory"
          Condition="$(IF_OverrideAssemblies.Contains('PresentationCore'))
                     and '$(RuntimeIdentifier)' != 'win-x64'
                     and '$(RuntimeIdentifier)' != ''">
    <Warning Text="InitialForce.WPF.RuntimeOverride is currently a no-op on RID '$(RuntimeIdentifier)'; PresentationCore will not be overridden." />
  </Target>

  <Target Name="InjectIfWpfAssembly_PresentationCore"
          AfterTargets="Build;CopyFilesToOutputDirectory"
          Condition="$(IF_OverrideAssemblies.Contains('PresentationCore'))
                     and '$(RuntimeIdentifier)' == 'win-x64'">
    <Copy SourceFiles="$(_IFWpfRORuntimeDir)PresentationCore.dll"
          DestinationFolder="$(OutDir)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_IFWpfRORuntimeDir)PresentationCore.dll">
        <RelativePath>PresentationCore.dll</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Importance="high"
             Text="InjectIfWpfAssembly_PresentationCore: replaced with InitialForce.WPF.RuntimeOverride patched DLL in $(OutDir)" />
  </Target>

